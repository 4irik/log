flowchart TB
    subgraph A["Обычная хвостовая рекурсия"]
        direction TB
        A1["fact(1_000_000, 1)"]
        A2["fact(999_999, 1_000_000)"]
        A3["fact(999_998, ...)"]
        A4["..."]
        A5["fact(0, result)"]
        A6["Возврат результата"]

        A1 --> A2
        A2 --> A3
        A3 --> A4
        A4 --> A5
        A5 --> A6

        A7["Стек вызовов растёт"]
        A1 -.-> A7
    end

    subgraph B["Trampolining"]
        direction TB
        B1["trampoline()"]
        B2["fact(1_000_000, 1)"]
        B3["Возвращает Thunk"]
        B4["Выполняет Thunk.resume()"]
        B5["fact(n - 1, acc * n)"]
        B6{"Результат — Thunk?"}
        B7["Возвращает итоговый результат"]

        B1 --> B2
        B2 --> B3
        B3 --> B4
        B4 --> B5
        B5 --> B6
        B6 -->|Да| B3
        B6 -->|Нет| B7

        B8["Стек вызовов остаётся постоянным"]
        B1 -.-> B8
    end

    style A7 fill:#fee2e2,stroke:#dc2626,color:#991b1b
    style B8 fill:#dcfce7,stroke:#16a34a,color:#166534
